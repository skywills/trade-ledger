# Copy to `.env` (never commit `.env`) to run without compose.
# The container defaults already match these values.
DATA_DIR=/data
# Listener bind address. Loopback by default; the image sets 0.0.0.0. Do not
# widen it outside a container without an authenticating reverse proxy.
HOST=127.0.0.1
PORT=3000
ALLOWED_ORIGIN=http://localhost:3000
UPLOAD_LIMIT_BYTES=20971520

# Optional: extra comma-separated host[:port] values accepted in the Host
# header. The ALLOWED_ORIGIN host and loopback names are always accepted.
# ALLOWED_HOSTS=journal.lan:3000

# Optional: allowlist a directory of mounted secret files for profile `file:`
# credential references. Leave unset for environment-only references.
# JOURNAL_SECRETS_DIR=/secrets

# Never place provider API keys here. Reference them through the environment
# (profile credentialRef `env:NAME_API_KEY`; only uppercase *_API_KEY names
# are accepted) or mounted secret files, and pass them at run time only. No key is ever written to the image, a backup or a log.
