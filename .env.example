# Copy to `.env` (never commit `.env`) to run without compose.
# The container defaults already match these values.
DATA_DIR=/data
PORT=3000
ALLOWED_ORIGIN=http://localhost:3000
UPLOAD_LIMIT_BYTES=20971520

# Optional: allowlist a directory of mounted secret files for profile `file:`
# credential references. Leave unset for environment-only references.
# JOURNAL_SECRETS_DIR=/secrets

# Never place provider API keys here. Reference them through the environment
# (profile credentialRef `env:NAME`) or mounted secret files, and pass them at
# run time only. No key is ever written to the image, a backup or a log.
