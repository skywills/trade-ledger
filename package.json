{
  "name": "ibkr-trade-journal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.3",
    "@fastify/static": "10.1.6",
    "@nathapp/nax-agent": "0.87.1",
    "@nathapp/nax-ai": "0.87.1",
    "better-sqlite3": "13.0.3",
    "csv-parse": "7.0.3",
    "decimal.js": "10.6.0",
    "fastify": "5.12.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tar": "7.5.22",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.0",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.64.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "check:all": "npm run lint && npm run typecheck",
    "test:e2e": "playwright test",
    "test:docker": "docker compose config --quiet"
  }
}
